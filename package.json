{
  "name": "mindfarm",
  "version": "0.4.0",
  "description": "A document-based mind mapping app for macOS",
  "author": "MindFarm",
  "license": "Apache-2.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,yml,md}\"",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "npm run build && node scripts/smoke-inspector.mjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:mac:unsigned": "npm run build && electron-builder --mac --config electron-builder.yml -c.mac.identity=null"
  },
  "dependencies": {
    "@zumer/snapdom": "^3.3.0",
    "mind-elixir": "^5.15.1",
    "pdf-lib": "^1.17.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  }
}
